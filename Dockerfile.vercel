FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Biblioteca nativa que Rasterio necesita
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# Instalar las dependencias ya declaradas
# en el pyproject.toml del proyecto
COPY pyproject.toml ./

RUN python -c "import tomllib, subprocess; deps=tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; subprocess.check_call(['python','-m','pip','install','--no-cache-dir',*deps])"

# Copiar TerraRover
COPY . .

# Ejecutar la API original
CMD ["sh", "-c", "exec uvicorn backend.api:app --host 0.0.0.0 --port ${PORT:-80}"]
